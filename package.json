    "d3-geo": "^3.1.1",
    "express": "^5.3.0",
    "framer-motion": "^14.3.0",
    "harfbuzzjs": "^1.6.3",
    "lucide-react": "^1.58.0",
    "phaser": "^3.90.0",
    "qrcode": "^1.5.4",
